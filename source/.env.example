# ==================================================
# Shared environment settings
# File mẫu để sao chép và chỉnh lại cho từng môi trường
# ==================================================

# Tên ứng dụng hiển thị chung cho frontend và backend
APP_NAME=TourFlow

# Môi trường chạy hiện tại: development | production | test
APP_ENV=development

# ==================================================
# Frontend settings
# Các biến bắt đầu bằng VITE_ sẽ được frontend đọc khi build/chạy dev
# ==================================================

# Cổng dev server của Vite
FRONTEND_PORT=5173

# URL frontend dùng để mở trên trình duyệt hoặc cấu hình callback
FRONTEND_URL=http://localhost:5173

# Tên ứng dụng hiển thị trong frontend
VITE_APP_NAME=TourFlow

# Địa chỉ API mà frontend sẽ gọi khi nối backend thật
VITE_API_BASE_URL=http://localhost:3000/api

# ==================================================
# Backend settings
# Dùng cho server Node.js/Express ở giai đoạn backend
# ==================================================

# Cổng backend chạy local
BACKEND_PORT=3000

# URL đầy đủ của backend
BACKEND_URL=http://localhost:3000

# URL frontend được backend cho phép kết nối, ví dụ CORS hoặc redirect
CLIENT_URL=http://localhost:5173

# Tiền tố chung cho toàn bộ API route
API_PREFIX=/api

# ==================================================
# Database settings
# Thông tin kết nối MySQL
# ==================================================

# Host của MySQL
DB_HOST=localhost

# Port mặc định của MySQL
DB_PORT=3306

# Tên database chính của project
DB_NAME=tour_db

# Tài khoản kết nối database
DB_USER=root

# Mật khẩu database, để trống nếu máy local chưa đặt password
DB_PASSWORD=

# ==================================================
# Authentication settings
# Cấu hình xác thực JWT cho backend
# ==================================================

# Chuỗi bí mật để ký JWT, cần thay đổi khi đưa lên môi trường thật
JWT_SECRET=change_me_for_real_project

# Thời gian hết hạn token
JWT_EXPIRES_IN=1d
